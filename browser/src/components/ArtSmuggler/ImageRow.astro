---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: ImageMetadata; caption: string }[];
  columns?: number;
}

const { images, columns = images.length } = Astro.props;
---

<div class="image-row" style={`--columns: ${columns}`}>
  {
    images.map(({ src, caption }) => (
      <figure>
        <a href={src.src} target="_blank" rel="noopener">
          <Image src={src} alt={caption} widths={[400, 800]} sizes="(max-width: 600px) 100vw, 400px" />
        </a>
        <figcaption>{caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .image-row {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  figure {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 600px) {
    .image-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
