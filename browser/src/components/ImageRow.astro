---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// An image, or a video given as a URL (e.g. an imported .mp4) with its aspect ratio
type Item =
  | { src: ImageMetadata; caption: string; alt?: string }
  | { src: string; caption: string; alt?: string; aspect?: number };

interface Props {
  images: Item[];
}

const { images } = Astro.props;

// Each item's width is proportional to its aspect ratio, so everything in the row ends up the same height
const aspectOf = (item: Item) =>
  typeof item.src === "string"
    ? ("aspect" in item && item.aspect) || 16 / 9
    : item.src.width / item.src.height;
---

<div class="image-row">
  {
    images.map((item) => (
      <figure style={`flex: ${aspectOf(item)} 1 0`}>
        {typeof item.src === "string" ? (
          <video
            src={item.src}
            controls
            muted
            playsinline
            preload="metadata"
            aria-label={item.alt ?? item.caption}
            style={`aspect-ratio: ${aspectOf(item)}`}
          />
        ) : (
          <a href={item.src.src} target="_blank" rel="noopener">
            <Image
              src={item.src}
              alt={item.alt ?? item.caption}
              widths={[400, 800]}
              sizes="(max-width: 600px) 100vw, 400px"
            />
          </a>
        )}
        <figcaption>{item.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .image-row {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  figure {
    margin: 0;
    min-width: 0;
  }

  img,
  video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  video {
    background-color: #000;
  }

  figcaption {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 600px) {
    .image-row {
      flex-direction: column;
    }
  }
</style>
